import heapq

#The syntax on A* Algo is used as such
def a_star(graph, heuristic, start, goal):

#Name of list is open_list. heuristic[start], start gives node name and its heuristic value.
#Also visited is a variable used to set the queue
    open_list =[(heuristic[start], start)]
    visited = set()

#when working on list
    while open_list:

#Heappop will remove the unwanted nodes from the list. when the node found is the goal, it prints this
        cost, current = heapq.heappop(open_list)
        if current == goal:
            print("Goal found",current)
            return

#if current node not in the set, add the current node and print it
        if current not in visited:
            visited.add(current)
            print("Visited:",current)

#the neighboring nodes are have their distance, and cost calculated to find the closest distance.
#heappush adds the needed/'closest distance' nodes to the visited and checks its cost and dist and if it in set 
            for neighbour, distance in graph[current]:
                if neighbour not in visited:
                    f_cost = cost + distance + heuristic[neighbour]
                    heapq.heappush(open_list,(f_cost,neighbour))

#Graph
graph = {
    'A':[('B',1),('C',3)],
    'B':[('D',3),('E',1)],
    'C':[('F',5)],
    'D':[],
    'E':[('F',1)],
    'F':[]
}

#Heuristic values
heuristic ={
    'A':6,
    'B':4,
    'C':4,
    'D':3,
    'E':2,
    'F':0,
}

#prints A*
a_star(graph, heuristic, 'A','F')






